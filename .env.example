# PostgreSQL：沿用原專案的環境變數與 URL 格式
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/taiwan_lottery
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@localhost:5432/taiwan_lottery
# SQLite 單機替代（取消註解並移除上面兩個值）
# DATABASE_URL=sqlite+aiosqlite:///./bingo.sqlite3
# DATABASE_URL_SYNC=sqlite:///./bingo.sqlite3
APP_NAME=賓果研究系統
DEBUG=false
MODEL_ARTIFACTS_DIR=./model_artifacts
SCRAPER_ENABLED=true
SYNC_INTERVAL_SECONDS=45
CPU_THREADS=2
TRAIN_WINDOW=1000
HISTORY_MIN_DRAWS=100
MAX_BACKFILL_DAYS=31
RETRAIN_MIN_DRAWS=36
RETRAIN_INTERVAL_SECONDS=10800
AUTO_TRAIN=true
